---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Bento from '../components/Bento.astro';
import Closing from '../components/Closing.astro';
import '../styles/global.css';
---

<Base
  title="F Wrds: #@!% typing the same $#!% twice."
  description="A free, open source text expander for your Mac menu bar, with a real window for managing snippets. MIT-Licensed."
  skipTarget="main"
>
  <main id="main">
    <div class="wrap">
      <Hero />
    </div>
    <div class="wrap">
      <Bento />
      <Closing />
    </div>
  </main>
</Base>
