---
import Glyph from './Glyph.astro';

const path = Astro.url.pathname;
const docsCurrent = path === '/docs/' ? 'page' : path.startsWith('/docs/') ? 'true' : undefined;
---

<div class="wrap">
  <nav class="site-nav" aria-label="Main">
    <a class="logo" href="/"><Glyph /><span class="logo-text">F Wrds</span></a>
    <div class="site-nav-r">
      <button class="site-search-btn" type="button" data-site-search aria-keyshortcuts="Meta+K Control+K">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <span class="site-search-label">Search</span>
        <span class="site-search-kbd" aria-hidden="true">⌘K</span>
      </button>
      <a class="site-nav-link" href="/docs/" aria-current={docsCurrent}>Docs</a>
      <a class="btn sm" data-download href="https://github.com/thomasguillot/f-wrds/releases/latest"><span>Download<span class="wide"> for Mac</span></span></a>
    </div>
  </nav>
</div>

<script>
  import '../scripts/search-trigger';
</script>
