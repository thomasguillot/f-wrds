---
import Base from './Base.astro';
import '../styles/docs.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<Base title={`${title} | F Wrds Docs`} description={description} ogType="article" htmlClass="dark docs" skipTarget="nd-page">
  <div class="wrap docs-wrap">
    <slot />
  </div>
</Base>
