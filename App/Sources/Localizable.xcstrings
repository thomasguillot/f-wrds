        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est pas un fichier Espanso valide : %@."
          }
        }
      }
    },
    "%@ isn't an Espanso file (.yml or .yaml).": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't an Espanso file (.yml or .yaml)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est pas un fichier Espanso (.yml ou .yaml)."
          }
        }
      }
    },
    "%@ of %@": {
