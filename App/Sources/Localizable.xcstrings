{
  "sourceLanguage": "en-GB",
  "strings": {
    "#@!% typing the same $#!% twice.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "#@!% typing the same $#!% twice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "#@!%, marre de taper toujours la même chose."
          }
        }
      }
    },
    "%@ (missing)": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (missing)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (manquante)"
          }
        }
      }
    },
    "%@ couldn't be read.": {
      "extractionState": "extracted_with_value",
