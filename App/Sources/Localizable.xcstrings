            "value": "%@ sur %@"
          }
        }
      }
    },
    "%lld snippets": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld snippet"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld snippets"
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld extrait"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld extraits"
                }
              }
            }
          }
        }
      }
    },
    "(clipboard)": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "(clipboard)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "(presse-papiers)"
          }
        }
      }
    },
    "**Accessibility** lets F Wrds type the full text into the app you are using.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Accessibility** lets F Wrds type the full text into the app you are using."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Accessibility** permet à F Wrds de saisir le texte complet dans l'application que vous utilisez."
          }
        }
      }
    },
    "**Ask me**: asks you a question when the snippet expands, then inserts your answer.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ask me**: asks you a question when the snippet expands, then inserts your answer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Demandez-moi** : vous pose une question quand l'extrait se développe, puis insère votre réponse."
          }
        }
      }
    },
    "**Capital letters**: how a capitalised trigger changes the text. Choose None, First letter, Each word or All capitals. Use it with **Match the case I type**.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Capital letters**: how a capitalized trigger changes the text. Choose None, First letter, Each word or All capitals. Use it with **Match the case I type**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Capital letters**: how a capitalised trigger changes the text. Choose None, First letter, Each word or All capitals. Use it with **Match the case I type**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Majuscules** : comment un déclencheur en majuscules modifie le texte. Choisissez Aucun, Première lettre, Chaque mot ou Tout en majuscules. À utiliser avec **Reproduire la casse que je saisis**."
          }
        }
      }
    },
    "**Choice**: one option picked at random from a list.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Choice**: one option picked at random from a list."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Choix** : une option tirée au hasard dans une liste."
          }
        }
      }
    },
    "**Clipboard**: whatever you have copied.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Clipboard**: whatever you have copied."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Presse-papiers** : ce que vous avez copié."
          }
        }
      }
    },
    "**Date**: today's date, or a date before or after it, in the format you choose.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Date**: today's date, or a date before or after it, in the format you choose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Date** : la date du jour, ou une date avant ou après, dans le format de votre choix."
          }
        }
      }
    },
    "**Enabled**: turn a snippet off without deleting it.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Enabled**: turn a snippet off without deleting it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Activé** : désactive un extrait sans le supprimer."
          }
        }
      }
    },
    "**Export Backup…** saves every group, snippet, global variable and setting to one file. It is the only export that puts you back exactly where you left off.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Export Backup…** saves every group, snippet, global variable and setting to one file. It is the only export that puts you back exactly where you left off."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Exporter la sauvegarde…** enregistre tous les groupes, extraits, variables globales et réglages dans un seul fichier. C'est la seule exportation qui vous remet exactement là où vous en étiez."
          }
        }
      }
    },
    "**Export to Espanso…** writes your snippets as Espanso files, also available in the File menu. It is not a backup: app filters and on/off switches are left out. To export one group, right-click it in the sidebar and choose **Export…**.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Export to Espanso…** writes your snippets as Espanso files, also available in the File menu. It is not a backup: app filters and on/off switches are left out. To export one group, right-click it in the sidebar and choose **Export…**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Exporter vers Espanso…** écrit vos extraits sous forme de fichiers Espanso, aussi disponible dans le menu Fichier. Ce n'est pas une sauvegarde : les filtres d'applications et les interrupteurs sont omis. Pour exporter un seul groupe, faites un clic droit dessus dans la barre latérale et choisissez **Exporter…**."
          }
        }
      }
    },
    "**Fixed text**: text that stays the same, handy for reusing a phrase.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Fixed text**: text that stays the same, handy for reusing a phrase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Texte fixe** : un texte qui ne change pas, pratique pour réutiliser une phrase."
          }
        }
      }
    },
    "**Global…**: a global variable you defined once (see below).": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Global…**: a global variable you defined once (see below)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Variable globale…** : une variable globale que vous avez définie une fois (voir plus bas)."
          }
        }
      }
    },
    "**Input Monitoring** lets F Wrds see what you type, so it can notice a trigger.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Input Monitoring** lets F Wrds see what you type, so it can notice a trigger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Surveillance de l'entrée** permet à F Wrds de voir ce que vous saisissez, afin de repérer un déclencheur."
          }
        }
      }
    },
    "**Match the case I type**: type the trigger with a capital letter and the expansion follows. Type it in capitals and the expansion is in capitals.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Match the case I type**: type the trigger with a capital letter and the expansion follows. Type it in capitals and the expansion is in capitals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Reproduire la casse que je saisis** : saisissez le déclencheur avec une majuscule et l'expansion suit. Saisissez-le en majuscules et l'expansion est en majuscules."
          }
        }
      }
    },
    "**Never in these apps**: the group expands everywhere except in these apps.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Never in these apps**: the group expands everywhere except in these apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Jamais dans ces applications** : le groupe se développe partout sauf dans ces apps."
          }
        }
      }
    },
    "**Only expand after a space or punctuation**: the trigger only expands when it follows a space or a punctuation mark.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Only expand after a space or punctuation**: the trigger only expands when it follows a space or a punctuation mark."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Développer seulement après une espace ou une ponctuation** : le déclencheur ne se développe que s'il suit une espace ou un signe de ponctuation."
          }
        }
      }
    },
    "**Only in these apps**: the group expands in these apps and nowhere else.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Only in these apps**: the group expands in these apps and nowhere else."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Uniquement dans ces applications** : le groupe se développe dans ces apps et nulle part ailleurs."
          }
        }
      }
    },
    "**Paste** is fast and exact. It is the default.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Paste** is fast and exact. It is the default."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Coller** est rapide et exact. C'est le choix par défaut."
          }
        }
      }
    },
    "**Pinned** snippets sit at the top of the menu. To pin one, right-click it in the snippet list and choose **Pin to Menu Bar**. Choose **Unpin from Menu Bar** to remove it.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Pinned** snippets sit at the top of the menu. To pin one, right-click it in the snippet list and choose **Pin to Menu Bar**. Choose **Unpin from Menu Bar** to remove it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les extraits **Épinglés** sont en haut du menu. Pour en épingler un, faites un clic droit dessus dans la liste des extraits et choisissez **Épingler dans la barre de menus**. Choisissez **Retirer de la barre de menus** pour le retirer."
          }
        }
      }
    },
    "**Preview** shows what the snippet will expand to. Shell commands do not run in the preview.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Preview** shows what the snippet will expand to. Shell commands do not run in the preview."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Aperçu** montre ce que l'extrait va devenir. Les commandes Shell ne sont pas exécutées dans l'aperçu."
          }
        }
      }
    },
    "**Recent** lists the snippets you expanded last.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Recent** lists the snippets you expanded last."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les **Récents** listent les derniers extraits développés."
          }
        }
      }
    },
    "**Restore Backup…** replaces everything currently in F Wrds with what is in the file. This cannot be undone.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Restore Backup…** replaces everything currently in F Wrds with what is in the file. This cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Restaurer la sauvegarde…** remplace tout ce qui se trouve dans F Wrds par le contenu du fichier. Cette action est irréversible."
          }
        }
      }
    },
    "**Shell**: runs a command and inserts what it prints.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Shell**: runs a command and inserts what it prints."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Shell** : exécute une commande et insère ce qu'elle affiche."
          }
        }
      }
    },
    "**Typed** types the text key by key. Use it for apps that do not accept a paste, mostly terminals.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Typed** types the text key by key. Use it for apps that do not accept a paste, mostly terminals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Taper** saisit le texte touche par touche. Utilisez-le pour les apps qui n'acceptent pas le collage, surtout les terminaux."
          }
        }
      }
    },
    "A global variable can't point to another global variable. Pick one of the types above.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A global variable can't point to another global variable. Pick one of the types above."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une variable globale ne peut pas pointer vers une autre variable globale. Choisissez l'un des types ci-dessus."
          }
        }
      }
    },
    "A new version of F Wrds is available": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A new version of F Wrds is available"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle version de F Wrds est disponible"
          }
        }
      }
    },
    "A shell variable shows ⚠︎": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A shell variable shows ⚠︎"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une variable Shell affiche ⚠︎"
          }
        }
      }
    },
    "A snippet can have several triggers. Any of them expands it. Click the cross on a trigger to remove it.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A snippet can have several triggers. Any of them expands it. Click the cross on a trigger to remove it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un extrait peut avoir plusieurs déclencheurs. N'importe lequel le développe. Cliquez sur la croix d'un déclencheur pour le retirer."
          }
        }
      }
    },
    "A snippet inserts text when you type its trigger. Add one with Add Snippet.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A snippet inserts text when you type its trigger. Add one with Add Snippet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un extrait insère du texte quand vous saisissez son déclencheur. Ajoutez-en un avec Ajouter un extrait."
          }
        }
      }
    },
    "A snippet uses either Text triggers or a Regex, not both. Switch back to **Text** and your triggers are still there.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A snippet uses either Text triggers or a Regex, not both. Switch back to **Text** and your triggers are still there."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un extrait utilise soit des déclencheurs Texte, soit une Regex, pas les deux. Revenez à **Texte** et vos déclencheurs sont toujours là."
          }
        }
      }
    },
    "A snippet with no trigger never expands. A trigger can be up to 64 characters long.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A snippet with no trigger never expands. A trigger can be up to 64 characters long."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un extrait sans déclencheur ne se développe jamais. Un déclencheur peut compter jusqu'à 64 caractères."
          }
        }
      }
    },
    "A variable is a placeholder that is filled in each time the snippet expands. Click **Insert Variable** above the content and pick a type. The variable appears in the content as a chip. Click a chip to set it up.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A variable is a placeholder that is filled in each time the snippet expands. Click **Insert Variable** above the content and pick a type. The variable appears in the content as a chip. Click a chip to set it up."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une variable est un espace réservé rempli à chaque expansion de l'extrait. Cliquez sur **Insérer une variable** au-dessus du contenu et choisissez un type. La variable apparaît dans le contenu sous forme de pastille. Cliquez sur une pastille pour la configurer."
          }
        }
      }
    },
    "A variable that is no longer in the content waits under **Not used in the content**. You can put it back or remove it there.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A variable that is no longer in the content waits under **Not used in the content**. You can put it back or remove it there."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une variable qui n'est plus dans le contenu attend sous **Non utilisée dans le contenu**. Vous pouvez l'y remettre ou la retirer."
          }
        }
      }
    },
    "About F Wrds": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "About F Wrds"
          }
        },
        "fr": {
          "stringUnit": {
